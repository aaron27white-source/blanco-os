# Copy to .env to override. Every value below is the built-in default.

# --- identity ---
BLANCO_OS_OPERATOR_NAME=Blanco
BLANCO_OS_OPERATOR_HANDLE=5lanxo
BLANCO_OS_TIMEZONE=America/Chicago

# --- paths ---
# The OS database. Keep it on the native fs: SQLite journaling is unreliable
# over the /mnt/c FUSE mount.
BLANCO_OS_DB_PATH=/home/you/workspace/blanco-os/data/blanco_os.db
BLANCO_OS_VAULT_PATH=/home/you/vault
BLANCO_OS_WORKSPACE_PATH=/home/you/workspace

# --- live probes ---
BLANCO_OS_OPENCLAW_URL=http://localhost:8080
BLANCO_OS_PROBE_TIMEOUT_SECONDS=1.5
# Set false to disable every outbound probe (offline demos, design work).
BLANCO_OS_PROBES_ENABLED=true

# --- notifications ---
BLANCO_OS_NOTIFY_ENABLED=true
# info | warning | critical — alerts below this are not announced.
BLANCO_OS_NOTIFY_MIN_SEVERITY=warning
# Optional. Leave blank and notifications still land in workspace/hq/INBOX/,
# which Sweet Jones relays to Discord. Set it for a direct path that keeps
# working even when OpenClaw is the thing that's down.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
BLANCO_OS_DISCORD_WEBHOOK_URL=

# --- server ---
BLANCO_OS_HOST=127.0.0.1
BLANCO_OS_PORT=8800
BLANCO_OS_CORS_ORIGINS=*
